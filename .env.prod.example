# Production settings. Copy to .env.prod with `make prod-init` (it fills in a random password).
# .env.prod is git-ignored; never commit it.

# Database password: letters, digits, '_' and '-' only, at least 16 characters.
# `make prod-up` refuses to start while this is still the placeholder.
POSTGRES_PASSWORD=CHANGE_ME_run_make_prod_init

POSTGRES_USER=ezh
# The REAL database. Development uses english_zero_to_hero_dev in a different stack.
POSTGRES_DB=english_zero_to_hero

# Where the app listens on THIS machine. 127.0.0.1 = only this machine (and `tailscale serve`, see docs/DEPLOYMENT.md).
APP_BIND=127.0.0.1
APP_PORT=3100

# Who may use the app. The app has no login, so this list of devices is the lock: the Tailscale address (100.x.y.z) of each
# phone/computer you allow, separated by commas. Find an address with `tailscale status`. Example:
#   ALLOWED_IPS=100.101.102.103, 100.88.5.7
# Empty = every device on your tailnet can use the app. This machine itself is always allowed. After editing: make prod-up
# (a typo is refused before anything starts). See docs/DEPLOYMENT.md.
# อุปกรณ์ที่อนุญาต: เลข IP ใน Tailscale (100.x.y.z) ของแต่ละเครื่อง คั่นด้วยจุลภาค ดูเลขด้วย `tailscale status` ว่าง = ทุกอุปกรณ์ใน tailnet ใช้ได้
ALLOWED_IPS=

# How many backups `make prod-backup` keeps
BACKUP_KEEP=14
# How many AUTOMATIC daily backups are kept (a separate window: they never delete manual backups and vice versa). See docs/DEPLOYMENT.md
BACKUP_KEEP_AUTO=14
