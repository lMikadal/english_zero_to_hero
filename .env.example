# Copy to .env and fill in. Never commit .env

# PostgreSQL
# host is the compose service name; everything runs in Docker.
# This is the REAL database (production). In dev, docker-compose.yml overrides DATABASE_URL to
# english_zero_to_hero_dev, and `make db-reset` only touches names ending in _dev.
DATABASE_URL=postgres://ezh:ezh@postgres:5432/english_zero_to_hero

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Storage
RECORDINGS_DIR=/data/recordings

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI / Speech (server-side only)
ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
