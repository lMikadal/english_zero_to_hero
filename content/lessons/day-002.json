  "type": "lesson",
  "cefr": "preA1",
  "title": {
    "en": "How are you? Short vowel /e/",
    "th": "สบายดีไหม และเสียงสระสั้น /e/"
  },
  "objectives": [
    {
      "en": "Ask and answer 'How are you?'",
      "th": "ถามและตอบว่า 'How are you?' ได้"
    },
    {
      "en": "Hear and say the /e/ sound",
      "th": "ฟังและออกเสียง /e/ ได้"
    },
    {
      "en": "Say the letter names A to G",
      "th": "บอกชื่อตัวอักษร A ถึง G ได้"
    }
  ],
  "estimatedMinutes": 30,
  "vocab": [
    "v-how",
    "v-fine",
    "v-thank",
    "v-good",
    "v-bed",
    "v-pen",
    "v-friend"
  ],
  "sections": [
    {
      "skill": "pronunciation",
      "title": {
        "en": "The /e/ sound and letters A–G",
        "th": "เสียง /e/ และตัวอักษร A–G"
      },
      "exercises": [
        {
          "id": "d002-pron-01",
          "type": "phoneme_intro",
          "instruction": {
            "th": "ฟังและสังเกตรูปปาก"
          },
          "phoneme": "eh",
          "ipa": "/e/",
          "tipTh": "เสียงใกล้ 'เอะ' ของไทย ปากเปิดครึ่งหนึ่ง ลิ้นสูงกว่า /æ/ คนไทยมักเปลี่ยน bed เป็น 'แบด' จนฟังเหมือน bad ให้ยิ้มเล็กน้อยแล้วพูด 'เบ็ด' สั้น ๆ และอย่าลืมปิดเสียง d ท้ายคำ",
          "examples": [
            "bed",
            "pen",
            "ten",
            "red"
          ]
        },
        {
          "id": "d002-pron-02",
          "type": "minimal_pair",
          "instruction": {
            "th": "ฟังแล้วเลือกคำที่ได้ยิน"
          },
          "pairs": [
            {
              "a": "bad",
              "b": "bed",
              "answer": "b"
            },
            {
              "a": "pan",
              "b": "pen",
              "answer": "a"
            },
            {
              "a": "sat",
              "b": "set",
              "answer": "b"
            }
          ]
        },
        {
          "id": "d002-pron-03",
          "type": "repeat_after_me",
          "instruction": {
            "th": "ฟังแล้วพูดตามชื่อตัวอักษร ระวัง G ออกเสียง 'จี' (ไม่ใช่ 'กี') และ F ต้องมีเสียง f ท้ายคำ"
          },
          "text": "A, B, C, D, E, F, G",
          "ipa": "/eɪ biː siː diː iː ef dʒiː/"
        }
      ]
    },
    {
      "skill": "listening",
      "title": {
        "en": "How are you?",
        "th": "ถามสารทุกข์สุกดิบ"
