          "instruction": {
            "th": "ฟังแล้วเลือกว่าผู้พูดถามอะไร"
          },
          "audioText": "Hello, Sam. How are you?",
          "question": {
            "en": "What does the speaker ask?",
            "th": "ผู้พูดถามอะไร"
          },
          "choices": [
            "What is your name?",
            "How are you?",
            "Nice to meet you."
          ],
          "answer": 1
        },
        {
          "id": "d002-listen-02",
          "type": "listen_choose",
          "instruction": {
            "th": "ฟังแล้วเลือกตัวอักษรที่ได้ยิน"
          },
          "audioText": "G, E, B",
          "question": {
            "en": "Which letters do you hear?",
            "th": "ได้ยินตัวอักษรอะไร"
          },
          "choices": [
            "G, E, B",
            "G, E, D",
            "G, A, B"
          ],
          "answer": 0
        },
        {
          "id": "d002-listen-03",
          "type": "dictation",
          "instruction": {
            "th": "ฟังแล้วพิมพ์ตาม"
          },
          "audioText": "I'm fine, thank you.",
          "accept": [
            "I'm fine, thank you",
            "I'm fine, thank you.",
            "I am fine, thank you",
            "I am fine, thank you.",
            "I'm fine thank you",
            "I'm fine thank you.",
            "I am fine thank you",
            "I am fine thank you."
          ]
        }
      ]
    },
    {
      "skill": "speaking",
      "title": {
        "en": "Say how you are",
        "th": "บอกว่าสบายดีไหม"
      },
      "exercises": [
        {
          "id": "d002-speak-01",
          "type": "shadowing",
          "instruction": {
            "th": "พูดตามทันทีทีละประโยค"
          },
          "lines": [
            "Hello, Sam!",
            "How are you?",
            "I'm fine, thank you.",
            "And you?"
          ]
        },
        {
          "id": "d002-speak-02",
          "type": "speak_answer",
          "instruction": {
            "th": "ตอบคำถามด้วยเสียง"
          },
          "prompt": "Hello! How are you?",
          "sampleAnswer": "I'm fine, thank you. And you?",
          "keywords": [
            "fine",
            "thank"
          ]
        },
        {
          "id": "d002-speak-03",
          "type": "repeat_after_me",
          "instruction": {
            "th": "ฟังแล้วพูดตาม ระวังเสียง /e/ ในคำว่า friend และ Ben"
          },
          "text": "This is my friend, Ben.",
          "ipa": "/ðɪs ɪz maɪ frend ben/"
        }
      ]
    },
    {
      "skill": "reading",
      "title": {
        "en": "Meet a friend",
        "th": "แนะนำเพื่อน"
      },
      "exercises": [
        {
          "id": "d002-read-01",
          "type": "read_passage",
          "instruction": {
            "th": "อ่านแล้วตอบคำถาม"
          },
          "text": "Ann: Hello, Sam! How are you?\nSam: I'm good, thank you. And you?\nAnn: I'm fine, thank you. This is my friend, Ben.\nSam: Hello, Ben. Nice to meet you.\nBen: Nice to meet you, too.",
          "glossary": {
            "too": "ด้วยเช่นกัน",
            "This is": "นี่คือ (ใช้แนะนำคน)"
          },
          "questions": [
            {
              "question": {
                "en": "Who is Ann's friend?",
                "th": "ใครเป็นเพื่อนของแอน"
