  "type": "lesson",
  "cefr": "preA1",
  "title": {
    "en": "Spell your name! Short vowel /ʌ/",
    "th": "สะกดชื่อของคุณ และเสียงสระสั้น /ʌ/"
  },
  "objectives": [
    {
      "en": "Ask and answer 'How do you spell it?'",
      "th": "ถามและตอบว่า 'How do you spell it?' ได้"
    },
    {
      "en": "Hear and say the /ʌ/ sound",
      "th": "ฟังและออกเสียง /ʌ/ ได้"
    },
    {
      "en": "Say the letter names V to Z and spell your name aloud",
      "th": "บอกชื่อตัวอักษร V ถึง Z และสะกดชื่อตัวเองออกเสียงได้"
    }
  ],
  "estimatedMinutes": 30,
  "vocab": [
    "v-spell",
    "v-letter",
    "v-do",
    "v-cup",
    "v-bus",
    "v-sun",
    "v-come",
    "v-please"
  ],
  "sections": [
    {
      "skill": "pronunciation",
      "title": {
        "en": "The /ʌ/ sound and letters V–Z",
        "th": "เสียง /ʌ/ และตัวอักษร V–Z"
      },
      "exercises": [
        {
          "id": "d005-pron-01",
          "type": "phoneme_intro",
          "instruction": {
            "th": "ฟังและสังเกตรูปปาก"
          },
          "phoneme": "ah",
          "ipa": "/ʌ/",
          "tipTh": "เสียงสั้นคล้าย 'อะ' ที่ออกจากลำคอ ปากไม่กลม ลิ้นอยู่กลางปาก คนไทยมักออกเป็น 'อา' หรือ 'ออ' เช่น bus เป็น 'บอส' ให้พูด 'บัส' สั้น ๆ แล้วปล่อยลมเสียง s ท้ายคำให้ได้ยิน (ไม่ใช่ 'บัด') และปิดเสียง p, n ท้ายคำให้ชัด สังเกตว่า come สะกดด้วย o แต่ออกเสียง /ʌ/",
          "examples": [
            "cup",
            "bus",
            "sun",
            "come"
          ]
        },
        {
          "id": "d005-pron-02",
          "type": "minimal_pair",
          "instruction": {
            "th": "ฟังแล้วเลือกคำที่ได้ยิน"
          },
          "pairs": [
            {
              "a": "cup",
              "b": "cap",
              "answer": "b"
            },
            {
              "a": "bus",
              "b": "boss",
              "answer": "a"
            },
            {
              "a": "but",
              "b": "bet",
              "answer": "b"
            }
          ]
        },
        {
          "id": "d005-pron-03",
          "type": "repeat_after_me",
          "instruction": {
            "th": "ฟังแล้วพูดตามชื่อตัวอักษร ระวัง V ต้องใช้ฟันบนแตะริมฝีปากล่าง (ไม่ใช่ 'ว') และ Z สำเนียงอเมริกันเรียก 'zee' (ซี ที่มีเสียงสั่นในลำคอ) ส่วนสำเนียงอังกฤษเรียก 'zed' (เซ็ด)"
          },
          "text": "V, W, X, Y, Z",
          "ipa": "/viː ˈdʌbəljuː eks waɪ ziː/"
        }
      ]
    },
    {
      "skill": "listening",
      "title": {
