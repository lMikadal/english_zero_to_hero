        },
        {
          "id": "d005-listen-03",
          "type": "dictation",
          "instruction": {
            "th": "ฟังแล้วพิมพ์ตาม"
          },
          "audioText": "How do you spell it?",
          "accept": [
            "How do you spell it",
            "How do you spell it?"
          ]
        }
      ]
    },
