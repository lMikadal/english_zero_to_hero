      "title": {
        "en": "The long vowel /ɔː/ and numbers 11–15",
        "th": "เสียงสระยาว /ɔː/ และตัวเลข 11–15"
      },
      "exercises": [
        {
          "id": "d010-pron-01",
          "type": "phoneme_intro",
          "instruction": {
            "th": "ฟังและสังเกตรูปปาก"
          },
          "phoneme": "or",
          "ipa": "/ɔː/",
          "tipTh": "เสียง 'ออ' ยาว ห่อปากกลมเล็กน้อยและยืดเสียงให้นาน สำเนียงอเมริกันมีเสียง r ท้ายคำ เช่น four, door (ม้วนลิ้นเบา ๆ) ส่วนสำเนียงอังกฤษไม่มี r ต่างจาก /ɑː/ ใน hot ที่อ้าปากกว้างโดยไม่ห่อปาก คนไทยมักออกเป็น 'โอ' (เช่น door เป็น 'โดร์') ให้คงเสียง 'ออ' ไว้",
          "examples": [
            "four",
            "door",
            "water",
            "morning"
          ]
        },
        {
          "id": "d010-pron-02",
          "type": "minimal_pair",
          "instruction": {
