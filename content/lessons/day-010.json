  },
  "objectives": [
    {
      "en": "Ask 'Is it…?' and answer 'Yes, it is' or 'No, it is not'",
      "th": "ถาม 'Is it…?' และตอบ 'Yes, it is' หรือ 'No, it is not' ได้"
    },
    {
      "en": "Hear and say the long vowel /ɔː/ in four, door and water",
      "th": "ฟังและออกเสียงสระยาว /ɔː/ ในคำว่า four, door, water ได้"
    },
    {
      "en": "Say the numbers 11 to 20",
      "th": "พูดตัวเลข 11 ถึง 20 ได้"
    }
  ],
  "estimatedMinutes": 30,
  "vocab": [
    "v-twenty",
