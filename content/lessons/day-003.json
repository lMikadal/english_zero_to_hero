        "th": "แนะนำตัวสั้น ๆ"
      },
      "exercises": [
        {
          "id": "d003-read-01",
          "type": "read_passage",
          "instruction": {
            "th": "อ่านแล้วตอบคำถาม"
          },
          "text": "Hi! My name is Mai. I'm from Chiang Mai. It is a big city. Thailand is my country.\nThis is my friend, Tom. Tom is from England.",
          "glossary": {
            "England": "ประเทศอังกฤษ"
          },
          "questions": [
            {
              "question": {
                "en": "Where is Tom from?",
                "th": "ทอมมาจากที่ไหน"
              },
              "choices": [
                "Thailand",
                "England"
              ],
              "answer": 1
            },
            {
              "question": {
                "en": "Is Chiang Mai a big city?",
                "th": "เชียงใหม่เป็นเมืองใหญ่ไหม"
              },
              "choices": [
                "Yes",
                "No"
              ],
              "answer": 0
            }
          ]
        }
      ]
    },
    {
      "skill": "writing",
      "title": {
        "en": "Write where you are from",
        "th": "เขียนบอกว่ามาจากที่ไหน"
      },
      "exercises": [
