  "type": "lesson",
  "cefr": "preA1",
  "title": {
    "en": "Where are you from? Short vowel /ɪ/",
    "th": "คุณมาจากที่ไหน และเสียงสระสั้น /ɪ/"
  },
  "objectives": [
    {
      "en": "Ask and say where you are from",
      "th": "ถามและบอกว่ามาจากที่ไหนได้"
    },
    {
      "en": "Hear and say the /ɪ/ sound",
      "th": "ฟังและออกเสียง /ɪ/ ได้"
    },
    {
      "en": "Say the letter names H to N",
      "th": "บอกชื่อตัวอักษร H ถึง N ได้"
    }
  ],
  "estimatedMinutes": 30,
  "vocab": [
    "v-where",
    "v-from",
    "v-country",
    "v-city",
    "v-sit",
    "v-big",
    "v-hi",
    "v-fish"
  ],
  "sections": [
    {
      "skill": "pronunciation",
      "title": {
        "en": "The /ɪ/ sound and letters H–N",
        "th": "เสียง /ɪ/ และตัวอักษร H–N"
      },
      "exercises": [
        {
          "id": "d003-pron-01",
          "type": "phoneme_intro",
          "instruction": {
            "th": "ฟังและสังเกตรูปปาก"
          },
          "phoneme": "ih",
          "ipa": "/ɪ/",
          "tipTh": "เสียงสั้นและผ่อนคลาย ปากไม่ยิ้มกว้าง ถ้ายืดและยิ้มจะกลายเป็น /iː/ (อี) แล้วความหมายเปลี่ยน เช่น sit (นั่ง) กับ seat (ที่นั่ง) พูดให้สั้นกว่า 'อิ' ภาษาไทยเล็กน้อย และปิดเสียง t, g ท้ายคำ",
          "examples": [
            "sit",
            "big",
            "fish",
            "city"
          ]
        },
        {
          "id": "d003-pron-02",
          "type": "minimal_pair",
          "instruction": {
            "th": "ฟังแล้วเลือกคำที่ได้ยิน"
          },
          "pairs": [
            {
              "a": "sit",
              "b": "seat",
              "answer": "a"
            },
            {
              "a": "big",
              "b": "beg",
              "answer": "a"
            },
            {
              "a": "bit",
              "b": "beat",
              "answer": "b"
            }
          ]
        },
        {
          "id": "d003-pron-03",
          "type": "repeat_after_me",
          "instruction": {
            "th": "ฟังแล้วพูดตามชื่อตัวอักษร ระวัง J ออกเสียง 'เจ' ต่างจาก G ที่เป็น 'จี' และ I ออกเสียง 'ไอ' ส่วน L, M, N ต้องปิดเสียงท้าย"
          },
          "text": "H, I, J, K, L, M, N",
          "ipa": "/eɪtʃ aɪ dʒeɪ keɪ el em en/"
        }
      ]
    },
    {
      "skill": "listening",
      "title": {
        "en": "Where are you from?",
        "th": "คุณมาจากที่ไหน"
      },
      "exercises": [
        {
          "id": "d003-listen-01",
          "type": "listen_choose",
          "instruction": {
            "th": "ฟังแล้วตอบว่าแอนมาจากที่ไหน"
          },
          "audioText": "Hi! I'm Ann. I'm from Thailand. Sam is from England.",
          "question": {
            "en": "Where is Ann from?",
            "th": "แอนมาจากที่ไหน"
          },
          "choices": [
            "Thailand",
            "England",
            "Japan"
          ],
          "answer": 0
        },
        {
          "id": "d003-listen-02",
          "type": "dictation",
          "instruction": {
            "th": "ฟังแล้วพิมพ์ตาม"
          },
          "audioText": "Where are you from?",
          "accept": [
            "Where are you from",
            "Where are you from?"
          ]
        },
        {
          "id": "d003-listen-03",
          "type": "dictation",
          "instruction": {
            "th": "ฟังแล้วพิมพ์ตาม"
          },
          "audioText": "I'm from Bangkok.",
          "accept": [
            "I'm from Bangkok",
            "I'm from Bangkok.",
            "I am from Bangkok",
            "I am from Bangkok."
          ]
        }
      ]
    },
    {
      "skill": "speaking",
      "title": {
        "en": "Say where you are from",
        "th": "บอกว่ามาจากที่ไหน"
      },
      "exercises": [
        {
          "id": "d003-speak-01",
          "type": "shadowing",
          "instruction": {
            "th": "พูดตามทันทีทีละประโยค"
          },
          "lines": [
            "Hi! Where are you from?",
            "I'm from Thailand.",
            "Bangkok is a big city."
          ]
        },
        {
          "id": "d003-speak-02",
          "type": "speak_answer",
          "instruction": {
            "th": "ตอบคำถามด้วยเสียง โดยบอกว่าคุณมาจากที่ไหน"
          },
          "prompt": "Hello! Where are you from?",
          "sampleAnswer": "I'm from Thailand.",
          "keywords": [
            "from"
          ]
        },
        {
          "id": "d003-speak-03",
          "type": "repeat_after_me",
          "instruction": {
            "th": "ฟังแล้วพูดตาม ระวัง /ɪ/ สั้น ๆ ในคำว่า big และ city"
          },
          "text": "Bangkok is a big city.",
          "ipa": "/ˈbæŋkɑːk ɪz ə bɪɡ ˈsɪti/"
        }
      ]
    },
    {
      "skill": "reading",
      "title": {
