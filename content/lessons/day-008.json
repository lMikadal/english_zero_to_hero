  "title": {
    "en": "I am, you are! Numbers 1–5. Long vowel /iː/",
    "th": "I am, you are! ตัวเลข 1–5 และเสียงสระยาว /iː/"
  },
  "objectives": [
    {
      "en": "Say 'I am…' and 'You are…' about yourself and a friend",
      "th": "พูด 'I am…' และ 'You are…' เกี่ยวกับตัวเองและเพื่อนได้"
    },
    {
      "en": "Hear the difference between /ɪ/ (ship) and /iː/ (sheep)",
      "th": "แยกเสียงสั้น /ɪ/ (ship) กับเสียงยาว /iː/ (sheep) ได้ตอนฟัง"
    },
    {
      "en": "Say and understand the numbers one to five",
      "th": "พูดและเข้าใจตัวเลข one ถึง five ได้"
    }
  ],
  "estimatedMinutes": 30,
  "vocab": [
    "v-be",
    "v-number",
    "v-one",
    "v-two",
    "v-three",
    "v-four",
    "v-five",
    "v-tea"
  ],
  "sections": [
    {
      "skill": "pronunciation",
      "title": {
        "en": "The long vowel /iː/ and numbers 1–5",
        "th": "เสียงสระยาว /iː/ และตัวเลข 1–5"
      },
      "exercises": [
        {
          "id": "d008-pron-01",
          "type": "phoneme_intro",
          "instruction": {
            "th": "ฟังและสังเกตรูปปาก"
          },
          "phoneme": "ee",
          "ipa": "/iː/",
          "tipTh": "เสียง 'อี' ยาว ยิ้มกว้างเล็กน้อยแล้วยืดเสียงให้นานประมาณสองจังหวะ ต่างจาก /ɪ/ ที่เรียนไปในวันที่ 3 ซึ่งสั้นและผ่อนคลายกว่า คนไทยมักออกเสียงสองเสียงนี้เหมือนกัน ทำให้ sheep (แกะ) ฟังเป็น ship (เรือ) และ seat (ที่นั่ง) ฟังเป็น sit (นั่ง) สะกดได้หลายแบบ เช่น ee, ea ใน meet, tea และ three อย่าลืมปิดเสียง t ท้ายคำใน meet ให้ชัด",
          "examples": [
            "three",
            "tea",
            "see",
            "meet"
          ]
        },
        {
          "id": "d008-pron-02",
          "type": "minimal_pair",
          "instruction": {
            "th": "ฟังแล้วเลือกคำที่ได้ยิน"
          },
          "pairs": [
            {
              "a": "ship",
              "b": "sheep",
              "answer": "b"
            },
            {
              "a": "hit",
              "b": "heat",
              "answer": "a"
            },
            {
              "a": "it",
              "b": "eat",
              "answer": "b"
            },
            {
              "a": "feel",
              "b": "fill",
              "answer": "a"
            }
          ]
        },
        {
          "id": "d008-pron-03",
          "type": "repeat_after_me",
          "instruction": {
            "th": "ฟังแล้วพูดตาม ระวัง three ให้ปลายลิ้นแตะระหว่างฟัน (ไม่ใช่ 'ทรี') และ five ต้องมีเสียง v ท้ายคำ คือฟันบนแตะริมฝีปากล่าง (ไม่ใช่ 'ไฟว์' เสียงว ลอย ๆ)"
          },
          "text": "One, two, three, four, five.",
          "ipa": "/wʌn tuː θriː fɔːr faɪv/"
        }
      ]
    },
    {
