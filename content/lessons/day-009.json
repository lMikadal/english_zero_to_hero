          },
          "lines": [
            "How old are you, Ben?",
            "I am nine. And you?",
            "I am ten.",
            "This is my friend, Ann. She is eight.",
            "He is nine. She is eight."
          ]
        },
        {
          "id": "d009-speak-02",
          "type": "speak_answer",
          "instruction": {
            "th": "นับเลข 6 ถึง 10 ด้วยเสียง"
          },
          "prompt": "Six to ten, please.",
          "sampleAnswer": "Six, seven, eight, nine, ten.",
          "keywords": [
            "six",
            "ten"
          ]
        },
        {
          "id": "d009-speak-03",
          "type": "repeat_after_me",
          "instruction": {
            "th": "ฟังแล้วพูดตาม ระวัง he, she ให้ยืดเสียง /iː/ และ she ใช้เสียง /ʃ/ (ชู ริมฝีปากเล็กน้อย)"
          },
          "text": "He is my friend. She is my friend, too.",
          "ipa": "/hiː ɪz maɪ frend ʃiː ɪz maɪ frend tuː/"
        }
      ]
    },
