    {
      "skill": "pronunciation",
      "title": {
        "en": "Final /p/ and /b/",
        "th": "เสียง /p/ และ /b/ ท้ายคำ"
      },
      "exercises": [
        {
          "id": "d033-pron-01",
          "type": "phoneme_intro",
          "instruction": {
            "th": "ฟังและสังเกตรูปปาก"
          },
          "phoneme": "p",
          "ipa": "/p/ /b/",
          "tipTh": "ตัวสะกด บ ป พ ภาษาไทยออกเสียงเป็น /p/ ที่ปิดริมฝีปากโดยไม่ปล่อยลมเสมอ ในภาษาอังกฤษ /b/ ท้ายคำ (cab, cub) ต้องสั่นคอไปจนจบ ต่างจาก /p/ ใน up และ cup ที่คอไม่สั่นและมีลมออกเบา ๆ เมื่อเปิดริมฝีปาก คนไทยมักออก cab เป็น 'แค็บ' ซึ่งฟังเหมือน cap",
          "examples": [
            "up",
            "cup",
            "cab",
            "cub"
          ]
        },
        {
          "id": "d033-pron-02",
          "type": "minimal_pair",
          "instruction": {
            "th": "ฟังแล้วเลือกคำที่ได้ยิน"
          },
          "pairs": [
            {
              "a": "cap",
              "b": "cab",
              "answer": "a"
            },
            {
              "a": "robe",
              "b": "rope",
              "answer": "b"
            },
            {
              "a": "cub",
              "b": "cup",
