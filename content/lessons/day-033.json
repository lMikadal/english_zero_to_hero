  "objectives": [
    {
      "en": "Understand and say simple commands: Stand up, Open your mouth, Wash your hands",
      "th": "เข้าใจและพูดคำสั่งง่าย ๆ ได้: Stand up, Open your mouth, Wash your hands"
    },
    {
      "en": "Hear and say the final sounds /p/ and /b/: cap–cab, rope–robe, cup–cub, tap–tab",
      "th": "ฟังและออกเสียง /p/ กับ /b/ ท้ายคำ: cap–cab, rope–robe, cup–cub, tap–tab"
    },
    {
      "en": "Say what you wash and put with body words",
      "th": "บอกว่าล้างอะไรและวางอะไรไว้ตรงไหนด้วยคำเรียกอวัยวะได้"
    }
  ],
  "estimatedMinutes": 30,
