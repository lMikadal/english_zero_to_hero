  "objectives": [
    {
      "en": "Say 'We are…' and 'They are…' about groups of people",
      "th": "พูด 'We are…' และ 'They are…' เกี่ยวกับกลุ่มคนได้"
    },
    {
      "en": "Hear and say the long vowel /ɑː/ in car and park",
      "th": "ฟังและออกเสียงสระยาว /ɑː/ ในคำว่า car และ park ได้"
    },
    {
      "en": "Say where people and things are: in the park, in the shop",
      "th": "บอกว่าคนและสิ่งของอยู่ที่ไหน เช่น in the park, in the shop ได้"
    }
  ],
  "estimatedMinutes": 30,
