    {
      "skill": "pronunciation",
      "title": {
        "en": "The long vowel /ɑː/",
        "th": "เสียงสระยาว /ɑː/"
      },
      "exercises": [
        {
          "id": "d012-pron-01",
          "type": "phoneme_intro",
          "instruction": {
            "th": "ฟังและสังเกตรูปปาก"
          },
          "phoneme": "ar",
          "ipa": "/ɑː/",
          "tipTh": "เสียง 'อา' ยาว อ้าปากกว้างและยืดเสียงให้นาน ไม่ยิ้ม สัญลักษณ์นี้ตัวเดียวกับ hot ในวันที่ 4: สำเนียงอเมริกัน car ใช้สระเดียวกับ hot แล้วตามด้วย r ส่วนสำเนียงอังกฤษ hot เป็น /ɒ/ สั้น แต่ car เป็น /ɑː/ ยาวและไม่มี r ระวังอย่าให้สั้นจนเป็น 'แอ' แบบ pack (แพ็ค) และปิดเสียง k ใน park ให้ชัด",
          "examples": [
            "car",
            "park",
            "far",
            "start"
          ]
        },
        {
          "id": "d012-pron-02",
          "type": "minimal_pair",
          "instruction": {
            "th": "ฟังแล้วเลือกคำที่ได้ยิน"
