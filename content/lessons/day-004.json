    {
      "skill": "pronunciation",
      "title": {
        "en": "The hot/box vowel and letters O–U",
        "th": "เสียงสระใน hot/box และตัวอักษร O–U"
      },
      "exercises": [
        {
          "id": "d004-pron-01",
          "type": "phoneme_intro",
          "instruction": {
            "th": "ฟังและสังเกตรูปปาก"
          },
          "phoneme": "aa",
          "ipa": "/ɑː/",
          "tipTh": "เสียงนี้ต่างกันตามสำเนียง: อเมริกัน hot ออกคล้าย 'ฮาท' (อ้าปากกว้าง ลิ้นต่ำ ไม่ห่อปาก) ส่วนอังกฤษ hot ออกคล้าย 'ฮ็อท' (สระเอาะสั้น ห่อปากเล็กน้อย) เลือกสำเนียงเดียวแล้วฝึกให้สม่ำเสมอ อย่าห่อปากจนเป็น 'โฮท' และอย่าให้กลายเป็น 'ฮัท' (hut) และอย่าลืมปิดเสียง t, p ท้ายคำ",
          "examples": [
            "hot",
            "box",
            "stop",
            "not"
          ]
        },
        {
          "id": "d004-pron-02",
          "type": "minimal_pair",
          "instruction": {
            "th": "ฟังแล้วเลือกคำที่ได้ยิน"
          },
          "pairs": [
            {
              "a": "hot",
              "b": "hat",
              "answer": "a"
            },
            {
              "a": "not",
              "b": "nut",
              "answer": "b"
            },
            {
              "a": "hot",
              "b": "hut",
              "answer": "a"
            }
          ]
        },
        {
          "id": "d004-pron-03",
          "type": "repeat_after_me",
          "instruction": {
            "th": "ฟังแล้วพูดตามชื่อตัวอักษร ระวัง Q ออกเสียง 'คิว' และ R มีเสียงม้วนลิ้นเบา ๆ (US) (UK: R = 'อา' ไม่ม้วนลิ้น)"
          },
          "text": "O, P, Q, R, S, T, U",
          "ipa": "/oʊ piː kjuː ɑːr es tiː juː/"
        }
      ]
    },
