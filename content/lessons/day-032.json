  "objectives": [
    {
      "en": "Say how you feel and talk about animals: I am cold, a bird has two legs",
      "th": "บอกความรู้สึกและพูดถึงสัตว์: I am cold, a bird has two legs"
    },
    {
      "en": "Hear and say the final sounds /l/ and /n/: bell–Ben, mean–meal, pain–pale, will–win",
      "th": "ฟังและออกเสียง /l/ กับ /n/ ท้ายคำ: bell–Ben, mean–meal, pain–pale, will–win"
    },
    {
      "en": "Use cold, warm, hungry and tired with am, is and are",
      "th": "ใช้ cold, warm, hungry, tired กับ am, is, are ได้"
    }
  ],
