        {
          "id": "c030-listen-01",
          "type": "listen_choose",
          "instruction": {
            "th": "ฟังแล้วตอบคำถาม"
          },
          "audioText": "Good evening! I am Nok. You spell it N, O, K. I come from Chiang Mai. Thank you!",
          "question": {
            "en": "How does Nok spell her name?",
            "th": "นกสะกดชื่อของเธออย่างไร"
          },
          "choices": [
            "N, O, K",
            "N, A, K",
            "M, O, K"
          ],
          "answer": 0
        },
        {
          "id": "c030-listen-02",
          "type": "listen_choose",
          "instruction": {
            "th": "ฟังแล้วตอบคำถาม"
          },
          "audioText": "Ben is a doctor. He is thirty. Mai is a teacher. She is twenty. They are my friends.",
          "question": {
            "en": "How old is Mai?",
            "th": "ไหมอายุเท่าไร"
          },
          "choices": [
            "Twenty",
            "Thirty",
            "Twelve"
          ],
          "answer": 0
        },
        {
